{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program with tsx",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["tsx"],
      "args": ["${workspaceFolder}/router/services/batchRequest/index.ts"],
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/**/*.js"]
    }
  ]
}
